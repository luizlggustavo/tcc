{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "target": "es2016",
    "types": ["jest", "node"],
    "moduleResolution": "node10",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "include": ["jest.config.cts", "src/**/*.spec.ts", "src/**/*.d.ts"]
}
